{
  "name": "goal-progress-tracker-addon",
  "version": "1.2.0",
  "description": "An addon for tracking investment progress towards target amounts with progress visualization",
  "type": "module",
  "main": "dist/addon.js",
  "author": "Wealthfolio",
  "license": "MIT",
  "homepage": "https://github.com/afadil/wealthfolio",
  "keywords": [
    "wealthfolio",
    "addon",
    "investment",
    "goal",
    "progress",
    "tracker",
    "visualization"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rimraf dist",
    "package": "node ../../scripts/package-addon.mjs .",
    "bundle": "pnpm clean && pnpm build && pnpm package",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@wealthfolio/addon-sdk": "workspace:*",
    "@wealthfolio/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.5",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.1.1",
    "react-i18next": "^15.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@wealthfolio/addon-dev-tools": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup-plugin-external-globals": "^0.13.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md"
  ]
